      "── Mode piquage ──": ""
      "-_hover_piquage": "QgsFeature"
      "-_hover_piquage_band": "QgsRubberBand"
      "-_piquage_feat": "QgsFeature"
      "-_piquage_layer": "QgsVectorLayer"
      "-_piquage_reseau": "str"
      "-_piquage_cond_layer": "QgsVectorLayer"
      "-_piquage_reg_layer": "QgsVectorLayer"
      "-_piquage_snap_pt": "QgsPointXY"
      "-_piquage_snap_cond": "QgsFeature"
      "-_piquage_snap_band": "QgsRubberBand"
      "-_piquage_line_prev": "QgsRubberBand"
      "+finished": "pyqtSignal"
      "+canvasMoveEvent(event)": ""
      "+canvasReleaseEvent(event)": ""
      "+keyPressEvent(event)": ""
      "-_find_geom_near(pixel_pos)": "tuple"
      "-_start_geom_move()": ""
      "-_apply_geom_move(new_point)": ""
      "-_start_label_move()": ""
      "-_apply_label_move(new_point)": ""
      "-_collect_line_previews(line_layer)": ""
      "-_update_connected_lines(...)": ""
      "-_reproject_branchements(...)": ""
      "-_move_branchement_tabouret_end(branchement_layer, old_point, new_point)": ""
      "-_set_label_hidden(lbl, hidden)": ""
      "-_update_hover(pixel_pos)": ""
      "-_find_piquage_near(pixel_pos)": "tuple"
      "-_start_piquage_move()": ""
      "-_apply_piquage_move(snap_pt, snap_cond)": ""
      "-_update_piquage_snap(cursor_pt)": ""
      "-_clear_piquage_hover()": ""
      "-_line_angle_at(geom, pt) [static]": "float"
      "-_reset()": ""
      # Note : mode piquage — deplace le point de piquage d un
      # branchement le long de sa conduite. Met a jour id_conduite,
      # pk_debut, cote_piquage et geometrie.
      # _find_label_near() couvre les QUATRE roles : regards, tabourets,
      # conduites et branchements.
      # _line_angle_at() calcule LBL_ROT (angle en degres) pour les
      # etiquettes de conduite ET de branchement epinglees. Recalcule a
      # chaque deplacement, donc l angle se remet d aplomb si la geometrie
      # a bouge entre-temps.
      # La rotation d etiquette QGIS est comptee en degres HORAIRES
      # (cf. QgsPalLayerSettings.angleOffset), atan2 en anti-horaire :
      # LBL_ROT = -angle de la ligne. Sans l oppose, le texte sortait au
      # symetrique de sa conduite (ecart de 2 x l angle).
      # Segment de reference cherche au droit du point de depose.
      # Conduites incluses dans _find_geom_near (role conduite).
      # INVARIANT tabouret / piquage : les deux extremites d un branchement
      # sont independantes. Deplacer le tabouret ne bouge que le dernier
      # sommet (_move_branchement_tabouret_end), le piquage reste sur sa
      # conduite ; deplacer le piquage ne bouge que le premier sommet
      # (_apply_piquage_move), le tabouret reste en place. Une translation
      # rigide du branchement faisait glisser le piquage, voire sauter sur
      # une conduite voisine plus proche.
    }

