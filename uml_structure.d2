    }

    stareau_export: "stareau_export «module»" {
      shape: class
      class: module
      "── Constantes ──": ""
      "+CRS_STAREAU": "\"EPSG:2154\""
      "+SNAP_TOL": "0.05"
      "+LAYER_SCHEMAS": "dict[str, QgsFields]"
      "+LAYER_ORDER": "tuple[str]"
      "── API publique ──": ""
      "+source_layers(project)": "dict"
      "+check_conformity(project)": "list[dict]"
      "+file_name(params)": "str"
      "+export_stareau(params, out_path, project, progress)": "(str, dict)"
      "── Schemas ──": ""
      "-_fields(*specs)": "QgsFields"
      "-_schema_canalisation() / _schema_canalisation_branchement()": ""
      "-_schema_regard() / _schema_point_collecte() / _schema_raccord()": ""
      "-_CHAMP_COMMUN / _DIMENSION / _CANALISATION": ""
      "── Construction ──": ""
      "-_build_features(params, project)": "dict"
      "-_common_values(params, reseau)": "dict"
      "-_reversed_geometry(geom)": "QgsGeometry"
      "-_line_points(feat)": "list"
      "-_set(feat, values)": ""
      "-_val / _num / _txt(feat, name)": ""
      "-_slug(text) / _mat_dn(code_materiau, diametre)": ""
      # Note : arcs orientes dans le sens d ecoulement — StaR-Eau rattache
      # altitude_fil_eau_amont a noeudinitial, la geometrie est inversee
      # au besoin. Un branchement va de l ouvrage vers le piquage, ou un
      # ass_raccord est cree (ref_canalisation).
    }

    _IdFactory: {
      shape: class
      "-prefix": "str  (code chantier)"
      "-siren": "str"
      "-date": "str"
      "-_used": "set[str]"
      "+__init__(params)": ""
      "+make(reseau, key_parts, label_parts)": "(id_metier, cle_technique)"
      # Note : cle technique = UUID v5 deterministe derive du SIREN et de
      # la seule topologie — reexporter le meme chantier redonne les memes
      # cles, et corriger un materiau ne fait pas voir au destinataire une
      # suppression suivie d une creation.
      # Identifiant metier = descriptif et lisible :
      # 100-20260816-EU-C-PVC200-REU05-REU04
    }

    _NodeIndex: {
      shape: class
      "-_index": "QgsSpatialIndex"
      "-_points": "dict[slot, QgsPointXY]"
      "-_keys": "dict[slot, (role, fid)]"
      "+add(role, feat)": ""
      "+find(pt, tol)": "(role, fid) | None"
      # Note : appariement geometrique des extremites d arc et des
      # ouvrages a SNAP_TOL (5 cm) pour renseigner noeudinitial /
      # noeudterminal. Cle composite (role, fid) : les fid de regard et de
      # tabouret peuvent se recouvrir.
    }

