      + LBL_Y = "lbl_y"
      + LBL_VISIBLE = "lbl_visible"
      + LBL_ROT = "lbl_rot"
      + apply_etiquettes(layer, role)
      + remove_etiquettes(layer)
      + apply_label_size_all(plugin, mode, value)
      + apply_label_display_prefs(plugin, visibility)
      + get_label_display_prefs(plugin) : dict
      + apply_label_fields(plugin, fields_prefs)
      + build_expression(role, active_fields) : str
      + set_force_all_labels(enabled, canvas)
      + get_force_all_labels() : bool
      - _make_conduite_labeling(reseau, expression, size, unit) : QgsRuleBasedLabeling
      - _conduite_text_format() : QgsTextFormat
      - _conduite_current_settings(labeling) : QgsPalLayerSettings
      - _ensure_label_fields(plugin)
      .. Note ..
      ' Conduites : rule-based labeling (QgsRuleBasedLabeling).
      ' Regle 1 (lbl_x IS NULL) : placement Curved (curviligne).
      ' Regle 2 (lbl_x IS NOT NULL) : placement OverPoint epingle,
      '   orientation figee via LBL_ROT, callout active.
      ' LBL_ROT est ecrit par MoveTool (_conduite_angle_at) et
      ' efface par DeleteTool (_erase_label).
    }

