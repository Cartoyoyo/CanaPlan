  ' ─────────────────────────────────────────
  '  Package Tools
  ' ─────────────────────────────────────────
  package "tools" #FFF0F4 {

    class "graph_utils" <<module>> {
      + _to_float(val) : float
      + build_graph(conduite_layer, regard_layer, tol) : tuple
      + bfs(graph, start_id, end_id) : tuple
    }

    class "layer_ok" <<module>> {
      + layer_ok(layer) : bool
    }

    class "layer_keys" <<module>> {
      + layer_key(role, reseau) : str
      + get_layer_id(role, reseau) : str
      + set_layer_id(role, reseau, layer_id)
      .. Note ..
      ' Persiste les IDs de couches (regard/conduite/...) dans les
      ' proprietes du projet QGIS (.qgs) plutot qu'en QSettings
      ' globales : corrige le bug de confusion entre plusieurs
      ' projets ouverts successivement.
    }

    class "spatial_utils" <<module>> {
      + rect_request(pt, tol) : QgsFeatureRequest
      + nearest_point_feature(layer, pt, tol) : tuple
      + nearest_line_feature(layer, pt, tol) : tuple
      + nearest_line_feature_expanding(layer, pt, tols) : tuple
      .. Note ..
      ' Recherches spatiales indexees (bbox + distance), mutualisees
      ' par tous les outils carte (dessin, deplacement, cubature...).
    }

    class PointGrid {
      + __init__(items, cell)
      + nearest(pt, tol) : tuple
    }

    class "wfs_utils" <<module>> {
      + temp_dir() : str
      + purge_temp_dir()
      + write_geojson(features, prefix) : str
      + current_bbox_l93(canvas) : tuple
      + fetch_wfs_async(description, requests, on_done, timeout=30)
      - _fetch_features(typename, bbox, wfs_url, timeout) : list  {static}
      .. Note ..
      ' Telechargement WFS mutualise (BAN / PCI / BD TOPO) execute en
      ' QgsTask (tache de fond), TLS verifie, nettoyage automatique
      ' des GeoJSON temporaires apres chargement des couches.
    }

    class "calc_pentes" <<module>> {
      + recalc_pentes(conduite_layer, regard_layer, tol, branchement_layer, tabouret_layer)
    }

    class "calc_cubature" <<module>> {
      + calculer_cubature_troncon(conduite_feat, r_start, r_end, config) : dict
      + calculer_cubature_branchement(br_feat, tabouret_feat, config, regard_layer, conduite_layer) : dict
      + calculer_cubature_bfs(start_regard, end_regard, couches, config) : list[dict]
      + _calc_remblai_volumes(largeur, l3d, diametre_mm, volume, config) : tuple
      + _build_graph(conduite_layer, regard_layer, tol) : tuple
      + _bfs(graph, start_id, end_id) : tuple
