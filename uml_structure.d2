      "-_btn_add / _btn_del / _btn_up / _btn_dn": "QPushButton"
      "-_btn_pdf / _btn_png / _btn_close": "QPushButton"
      "── Formulaire canalisation ──": ""
      "-_rb_eu / _rb_ep": "QRadioButton"
      "-_sp_dn / _sp_prof": "QDoubleSpinBox"
      "-_cb_mat": "QComboBox"
      "── Formulaire tranchee ──": ""
      "-_sp_esp_g / _sp_ecg / _sp_ecd": "QDoubleSpinBox"
      "── Formulaire remblai ──": ""
      "-_sp_ep_lit / _sp_ep_enr": "QDoubleSpinBox"
      "-_cb_mat_lit / _cb_mat_enr / _cb_mat_rem": "QComboBox"
      "── Formulaire chaussee ──": ""
      "-_chk_inf / _chk_sup": "QCheckBox"
      "-_sp_ep_ci / _sp_ep_cs": "QDoubleSpinBox"
      "-_cb_mat_ci / _cb_mat_cs": "QComboBox"
      "+__init__(parent)": ""
      "-_build_ui()": ""
      "-_build_form()": ""
      "-_update_ch_enabled()": ""
      "-_add_tranche()": ""
      "-_remove_tranche()": ""
      "-_move_up()": ""
      "-_move_down()": ""
      "-_refresh_list()": ""
      "-_on_selection_changed(row)": ""
      "-_populate_form(t)": ""
      "-_on_field_changed(*_)": ""
      "-_draw()": ""
      "-_export(fmt)": ""
      "-_load_settings()": ""
      "-_save_settings()": ""
      "+closeEvent(event)": ""
      # Note : N tranches juxtaposees (EU / EP / AEP). Apercu matplotlib
      # temps reel — lit de pose, enrobage, remblai, chaussee inf/sup avec
      # couleurs conventionnelles (EU rouge, EP bleu, AEP cyan). Colonnes
      # de cotes verticales (droite) et sous-cotes horizontales (bas).
      # Valeurs par defaut heritees de ConfigDialog (cubature).
      # Memorisation QgsSettings : CanaPlan/coupe_tranchee_composee.
      # Export PDF / PNG via matplotlib (200 dpi).
      # Necessite matplotlib ; affiche un message si absent.
    }

