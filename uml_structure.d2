    PrintTool: {
      shape: class
      "-iface": "QgisInterface"
      "-s": "dict"
      "-_w": "float"
      "-_h": "float"
      "-_dpi": "int"
      "-_state": "int"
      "-_anchor": "QgsPointXY"
      "-_cur_rot": "float"
      "-_sheets": "list[dict]"
      "-_bands": "list[QgsRubberBand]"
      "-_preview": "QgsRubberBand"
      "+canvasMoveEvent(event)": ""
      "+canvasReleaseEvent(event)": ""
      "+keyPressEvent(event)": ""
      "-_place_sheet(center, rot, annoncer)": ""
      "+definir_feuilles(planches)": ""
      "+exporter_maintenant()": ""
      "-_corners(cx, cy, theta)": "list[QgsPointXY]"
      "-_corners_zone_carte(cx, cy, theta)": "list[QgsPointXY]"
      "-_generate_pdf(pdf_path, overview)": ""
      "-_start_render(cx, cy, rot, w_m, h_m, w_px, h_px) [static]": "QgsMapRendererParallelJob"
      "-_split_two_lines(text) [static]": "str"
      "-_overview_settings()": "dict|bool"
      "-_notify_finished()": ""
      "-_reset()": ""
      # Note : PDF multi-pages — pre-rendu de toutes les images avant
      # ouverture QPrinter (evite les interactions rendu/PDF Qt5).
      # Jobs QgsMapRendererParallelJob tous lances en simultane (latences
      # WMS/ortho recouvertes), attente via QProgressDialog annulable
      # (plus de waitForFinished bloquant). Images liberees au fil de
      # l ecriture des pages.
      # Fleche du nord (medaillon, suit la rotation de la planche).
      # ATTENTION au signe de la rotation : setRotation() fait tourner le
      # CONTENU, alors que rotation_rad oriente la PLANCHE. Le rendu utilise
      # donc setRotation(-degrees(rot)). Verifie sur l API : une ligne
      # d azimut +30 est redressee par -30 ; +30 la porte a +60, soit deux
      # fois l inclinaison. La fleche du nord suivait deja cette convention.
      # definir_feuilles() + exporter_maintenant() : le cadrage automatique
      # remplit les planches par calcul au lieu des clics, puis lance
      # l export sans attendre le clic droit.
      # on_finished : appele une fois quand l outil rend la main (export
      # termine OU abandon), differe d un tour de boucle. L export « Toutes
      # les pieces » s en sert pour refermer son archive.
      # Plan d ensemble : une teinte par planche (_couleur_planche), fonds
      # d abord puis contours puis numeros cernes de blanc ; le cadre trace
      # la ZONE CARTE (_corners_zone_carte), pas la feuille entiere.
      # Retour arriere / Suppr : depile la derniere feuille posee.
      # Echelle du plan d ensemble normalisee (1:500, 1:1000...) et
      # affichee au cartouche ; barre d echelle propre a l ensemble.
      # Confirmation avant ecrasement si output_dir predefini.
      # Plan d ensemble : plus de question modale, c est le reglage
      # plan_ensemble (case cochee par defaut) qui decide.
      # open_after : l export « Toutes les pieces » ecrit dans le TEMP puis
      # supprime, il desactive donc l ouverture du PDF et du DXF.
      # Zone carte = h_mm - carto_h_mm ; centre ajuste :
      #   cx_c = cx + (carto_h_m/2)*sin(rot),
      #   cy_c = cy + (carto_h_m/2)*cos(rot).
      # painter.save()/restore() obligatoire autour du dessin des
      # polygones semi-transparents (contours feuilles) : Qt5 PDF writer
      # ouvre un transparency group pour alpha<255 et ne le ferme pas sans
      # restore(), causant un voile blanc.
    }

