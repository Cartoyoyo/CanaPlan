      - _reset()
    }

    class CubatureTool {
      - canvas : QgsMapCanvas
      - iface : QgisInterface
      - couches_eu : dict
      - couches_ep : dict
      - opts : dict
      - show_remblai : bool
      - _start : QgsFeature
      - _reseau_start : str
      - _start_band : QgsRubberBand
      - _hover_band : QgsRubberBand
      - _dialog : CubatureDialog
      + {static} _SNAP_TOL_PX = 20
      + activate()
      + deactivate()
      + canvasMoveEvent(event)
      + canvasReleaseEvent(event)
      + keyPressEvent(event)
      - _compute_bfs(start_feat, end_feat, reseau)
      - _nearest_regard_any(point) : tuple
      - _find_layer_for_feat(feat) : QgsVectorLayer
      - _make_pt_band(color) : QgsRubberBand
      - _clear_band(attr)
      - _reset()
    }

    class CoupeTransversaleTool {
      - canvas : QgsMapCanvas
      - iface : QgisInterface
      - couches_eu : dict
      - couches_ep : dict
      - _points : list[QgsPointXY]
      - _band : QgsRubberBand
      + activate()
      + deactivate()
      + canvasMoveEvent(event)
      + canvasReleaseEvent(event)
      + canvasDoubleClickEvent(event)
      + keyPressEvent(event)
      - _update_band(cursor_pt)
      - _compute_and_show()
      - _reset()
    }

    class CoupeTransversaleSingleTool {
      - _reseau_label : str
      + __init__(canvas, iface, reseau, couches)
      + activate()
    }

    class PrintTool {
      - iface : QgisInterface
      - s : dict
      - _w : float
      - _h : float
      - _dpi : int
      - _state : int
      - _anchor : QgsPointXY
      - _cur_rot : float
      - _sheets : list[dict]
      - _bands : list[QgsRubberBand]
      - _preview : QgsRubberBand
      + canvasMoveEvent(event)
      + canvasReleaseEvent(event)
      + keyPressEvent(event)
      - _place_sheet(center, rot)
      - _generate_pdf(pdf_path)
      - {static} _render_map(cx, cy, rot, w_m, h_m, w_px, h_px) : QImage
      - {static} _split_two_lines(text) : str
      - {static} _ask_overview_settings(n, dpi) : bool
      - _reset()
      .. Note ..
      ' PDF multi-pages : pre-rendu de toutes les images
      ' (QgsMapRendererSequentialJob) avant ouverture QPrinter,
      ' evite les interactions rendu/PDF Qt5.
      ' Zone carte = h_mm - carto_h_mm ; centre ajuste :
      '   cx_c = cx + (carto_h_m/2)*sin(rot),
      '   cy_c = cy + (carto_h_m/2)*cos(rot).
      ' painter.save()/restore() obligatoire autour du dessin
      ' des polygones semi-transparents (contours feuilles) :
      ' Qt5 PDF writer ouvre un transparency group pour alpha<255
      ' et ne le ferme pas sans restore(), causant un voile blanc.
    }

    class AnnotationTool {
      - iface : QgisInterface
      - _paste_pending : bool
      - _cursor_pt : QgsPointXY
      + {static} _clipboard : dict
      + canvasMoveEvent(event)
      + canvasReleaseEvent(event)
      + keyPressEvent(event)
      + deactivate()
      - _annotation_at_cursor() : tuple
      - _paste_at(point) : bool
      .. Note ..
      ' Clic = creer/editer ; Ctrl+clic = duplique ;
      ' Ctrl+C / Ctrl+V = presse-papier interne (clipboard
      ' partage par variable de classe).
    }

    class "annotation_tool" <<module>> {
      + freeze_annotations_to_map_units(canvas) : int
      + find_annotation_at(canvas, click_pt) : tuple
      + make_text_format(vals) : QgsTextFormat
    }

    class "profil_batch" <<module>> {
      + export_profils_eu_ep(couches, reseau, fmt, output_dir) : tuple
      + export_profils_groupe(eu, ep, fmt, output_dir, reseau_ref) : tuple
      - _main_trunk_chain(couches) : tuple
      - _compute_piquages(conduites, abscisses, couches) : dict
      - _compute_groupe_data(eu, ep, pts) : dict
      - _safe_name(s) : str
      - _regard_name(feat) : str
    }

    class "dxf_export" <<module>> {
      + run_export_dxf_with_ui(iface, path, extent, scale, ...)
      + collect_visible_vector_layers() : list
      + open_dxf_externally(path)
    }

    class "dxf_postprocess" <<module>> {
      + add_label_decorations(dxf_path) : int
      + add_point_symbols(dxf_path) : int
      + apply_ltscale(dxf_path, scale)
    }

    class "star_dt_import" <<module>> {
      + import_star_dt(path, out, selected_types) : list
    }

    package "dxf_convert" #FFE8E8 {
      class CadToGisDialog {
        - iface : QgisInterface
        + __init__(iface)
        + exec_()
      }
    }
  }
}

