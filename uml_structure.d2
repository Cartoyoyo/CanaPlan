    star_dt_import: "star_dt_import «module»" {
      shape: class
      class: module
      "── Constantes ──": ""
      "+NS": "dict (star-dt / gml / xlink)"
      "+TYPE_STYLES": "dict[str, (QColor, largeur_mm, diam_m, pointille)]"
      "-_OUTPUT_TYPE_ORDER": "list[str]"
      "-_COMMON_FIELDS": "list[(nom, QVariant)]"
      "── API publique ──": ""
      "+scan_star_dt(gml_paths)": "dict[str, int]"
      "+sort_output_types(names)": "list[str]"
      "+import_star_dt(gml_paths, gpkg_path, selected_types)": "list"
      "── Lecture GML ──": ""
      "-_text(el, tag)": "str"
      "-_dimension(geom_el, values_count)": "int"
      "-_coords(text, dim)": "list[QgsPointXY]"
      "-_parse_point / _parse_linestring / _parse_polygon(geom_el)": ""
      "-_element_geometry(el)": "(QgsGeometry, srsName)"
      "-_iter_objects(root)": ""
      "-_output_type(el)": "str | None"
      "-_cable_output_type(el)": "str"
      "-_attribute_value(el, tag_name)": "str"
      "-_discover_fields(elements)": "list"
      "-_extract_file_identifier(gml_path)": "str"
      "-_as_path_list(gml_paths)": "list[str]"
      "── Ecriture / rendu ──": ""
      "-_release_gpkg(project, gpkg_path)": ""
      "-_same_file(path_a, path_b)": "bool"
      "-_apply_style(layer, out_type, is_cable)": ""
      "-_make_labeled_line_symbol(color, width, abbr, has_precision)": ""
      "-_apply_labels(layer, out_type)": ""
      "-_get_or_create_group(project, group_name)": ""
      # Note : multi-fichiers — les arbres XML restent ouverts pendant le
      # regroupement, sinon les elements deviennent invalides.
      # Aucune classe codee en dur : tout objet portant une <geometrie>
      # est importe. Seuls les CableElectrique sont scindes (HTA / BT via
      # classeTension). Champs decouverts.
      # SCR = srsName du GML, pas celui du projet.
      # Ecriture en 2 phases (ecrire puis charger) : garder le GPKG ouvert
      # pendant l ajout de tables perime le catalogue GDAL.
      # Largeurs et textes en mm : rendu identique ecran/impression.
    }

    stareau_values: "stareau_values «module»" {
      shape: class
      class: module
      "── Listes officielles StaR-Eau V2024 ──": ""
      "+TYPE_RESEAU / ETAT_SERVICE / PRECISION": ""
      "+MODE_CIRCULATION / TYPE_POSE / RAISON_POSE / ORIGINE": ""
      "+FORME / TYPE_USAGER / REVETEMENT_INTERIEUR / MATERIAU": ""
