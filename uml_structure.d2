    cadrage_auto: "cadrage_auto «module»" {
      shape: class
      class: module
      "+calculer_planches(couches, w_mm, h_mm, echelle, max, marge_mm)": "list"
      "+ordonner_planches(planches)": "list"
      "+harmoniser_orientations(planches, carto_h_m)": "list"
      "+mesurer_etiquettes(couches, echelle)": "(float, float)"
      "+marge_depuis_couches(couches, echelle, label_size)": "float"
      "+marge_pour_etiquettes(label_size, echelle)": "float"
      "+hauteur_cartouche_mm(h_mm)": "float"
      "+normaliser(angle)": "float"
      "+collecter_points(couches, pas)": "list"
      "-_axe_principal(points, cx, cy)": "float|None"
      "-_ecart_angulaire(a, b)": "float"
      "-_compter(points_uv, a0, w_u, b0, h_u)": "int"
      # Note : couverture gloutonne. A chaque tour on part de l element non
      # couvert le plus excentre, on essaie 12 orientations (pas de 15 deg
      # sur 180) x 25 decalages, et on retient la meilleure. L ALIGNEMENT
      # prime sur la couverture (tolerance 10 deg) : une planche penchee
      # exploite sa diagonale et gagnerait toujours au comptage, au prix
      # d un dossier de planches de travers. Cout mesure : +7 % de planches.
      # Repere papier identique a PrintTool._corners :
      #   largeur -> (cos t, -sin t)   hauteur -> (sin t, cos t)
      # Le centre rendu est celui de la FEUILLE : on retire un demi-
      # cartouche au centre de la zone carte.
      # Echelle large : si tout tient sur une planche, elle est centree sur
      # le reseau, rotation nulle (nord en haut).
      # Marge en MILLIMETRES PAPIER, pas en pourcentage : ce qui deborde est
      # la LARGEUR des etiquettes (une etiquette de regard fait ~58 mm en
      # 8 pt), et une etiquette occupe une taille fixe sur le papier quelle
      # que soit l echelle. Plafonnee a 20 % de la plus petite dimension
      # utile, sinon des etiquettes en unites carte a grande echelle ne
      # laisseraient plus de carte.
      # ordonner_planches : le glouton saute d un bout du chantier a l
      # autre ; on renumerote de proche en proche depuis la planche la plus
      # a l ouest.
      # harmoniser_orientations : deux planches jointives a +85 et -85 se
      # lisent tete-beche. On retourne une planche de 180 deg des qu elle
      # s ecarte de plus d un quart de tour de la precedente — meme emprise,
      # cartouche a l oppose, donc le centre FEUILLE se decale d une hauteur
      # de cartouche.
    }

    coupe_type: "coupe_type «module»" {
      shape: class
