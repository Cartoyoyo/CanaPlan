      "-_couches_valides(couches)": "iter"
      # Note : coupe representative sans troncon designe — diametre le plus
      # frequent, materiau dominant, profondeur moyenne (TN - fil d eau sur
      # les regards), largeur de la config projet. Le dessin est delegue a
      # CoupeTransversaleDialog, instancie sans etre affiche : aucune
      # duplication du code de rendu.
    }

