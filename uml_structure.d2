      "-_refresh_conduite_refs(role, fid)": ""
      "-_refresh_branchement_refs(role, fid)": ""
      "-_propagate_ouvrage(role, fid)": ""
      "── Copier / coller / annuler ──": ""
      "-_copy_selection()": ""
      "-_paste_selection()": ""
      "-_apply_batch()": ""
      "-_undo()": ""
      "── Navigation / apercu carte ──": ""
      "-_select_feature(role, fid)": ""
      "-_zoom_to_item(role, item)": ""
      "-_update_mini_map(table)": ""
      "-_goto_next_missing()": ""
      "── Onglet Chaine ──": ""
      "-_build_chain_tab()": ""
      "-_populate_chain_combos()": ""
      "-_build_graph()": ""
      "-_find_chain(key1, key2)": ""
      "-_detect_chain()": ""
      "-_chain_zoom_to_item(item)": ""
      # Note : saisie groupee par onglets (Regards / Tabourets /
      # Conduites / Branchements) avec calcul auto pente <-> cote fil
      # d eau selon le sens choisi (_recalc_cond_row /
      # _recalc_branch_row). Copier/coller compatible Excel, historique
      # Ctrl+Z, apercu carte miniature de la ligne selectionnee.
      # Onglet "Chaine" : trace le profil simplifie (ChainProfileWidget)
      # entre deux regards choisis, chemin trouve par BFS local.
      # Cascade : changer le FE d un ouvrage recalcule les conduites qui
      # s y raccordent, PUIS reinterpole la cote de piquage des
      # branchements portes par ces conduites
      # (cote = FE amont + (FE aval - FE amont) x pk / longueur),
      # meme formule que calc_pentes et DrawBranchementTool.
      # Sans effet en mode 'pente_cote', ou la pente pilote la cote.
      # Modes conduite : fe / pente_aval / pente_amont.
      # Modes branchement : fe / pente_fe / pente_cote, pente =
      # (cote piquage - FE tabouret) / longueur x 100 (le trace va du
      # piquage vers le tabouret).
    }

    ChainProfileWidget: {
      shape: class
      "+__init__(parent)": ""
      "+set_data(nodes)": ""
      "+paintEvent(event)": ""
      "-_text_width(fm, text) [static]": ""
    }

    etiquettes: "etiquettes «module»" {
      shape: class
      class: module

      "── Champs portes par les couches ──": ""
      "+LBL_X": "\"lbl_x\""
      "+LBL_Y": "\"lbl_y\""
      "+LBL_VISIBLE": "\"lbl_visible\""
      "+LBL_ROT": "\"lbl_rot\""

      "── Constantes de placement ──": ""
      "+LABEL_SIZE_MAP_UNITS": "2.0"
      "+LABEL_PADDING_MAP_UNITS": "0.4"
      "+LABEL_OFFSET_MAP_UNITS": "1.5"
      "+CALLOUT_MIN_LENGTH_MM": "1.5"
      "+LABEL_MIN_SCALE": "2000  (plafond, mode points)"
      "+MIN_READABLE_MM": "1.5"
      "+default_min_scale(size, unit)": "int"
      "-_PRIORITY": "dict[role, int]  (10 / 9 / 6 / 4)"
      "-_POINT_ROLES / _LINE_ROLES": ""
      "-_FORCE_SCOPE / _FORCE_KEY": "propriete de projet"

      "── API publique ──": ""
      "+apply_etiquettes(layer, role, reseau, size, unit, min_scale)": ""
      "+remembered_size()": "(valeur, unite)"
      "+remove_etiquettes(layer)": ""
      "+apply_label_size_all(plugin, mode, value, min_scale)": ""
      "+apply_label_display_prefs(plugin, visibility)": ""
      "+get_label_display_prefs(plugin)": "dict"
      "+apply_label_fields(plugin, fields_prefs)": ""
      "+build_expression(role, active_fields)": "str"
      "+sync_labels_after_rename(layer, role, reseau)": ""
      "+set_force_all_labels(enabled, canvas, plugin)": ""
      "+get_force_all_labels()": "bool"
      "+get_label_min_scale(plugin)": "int"

      "── Fabriques ──": ""
      "-_make_line_labeling(reseau, role, expr, size, unit, min_scale)": "QgsRuleBasedLabeling"
      "-_make_point_labeling(reseau, role, expr, size, unit, padding, min_scale, offset)": "QgsVectorLayerSimpleLabeling"
      "-_line_text_format(reseau, role, size, unit)": "QgsTextFormat"
      "-_line_current_settings(labeling)": "(expr, size, unit, min_scale)"
      "-_make_callout(dashed, min_length_mm)": "QgsSimpleLineCallout"
      "-_apply_placement_policy(pal, role, min_scale)": ""
      "-_mutate_pal(labeling, func)": "labeling"
      "-_ensure_label_fields(layer, role)": ""
      "-_reset_label_visibility(layer)": ""
      "-_clear_legacy_engine_flag()": ""

      # ── Note placement ──
      # Lignes (conduite ET branchement) : rule-based labeling.
      #   Regle 1 (lbl_x IS NULL)     : placement Curved.
      #   Regle 2 (lbl_x IS NOT NULL) : OverPoint epingle, orientation
      #     figee par LBL_ROT, callout en tirets.
      # LBL_ROT est ecrit par MoveTool (_line_angle_at) et efface par
      # DeleteTool (_erase_label).
      # Priorites : regard 10 > tabouret 9 > conduite 6 >
      #   branchement 4 — le moteur sacrifie d abord ce qui se retrouve le
      #   plus facilement dans la table.
      # Obstacles : seuls les ouvrages ponctuels (facteur 1.5). Une
      #   etiquette curviligne est censee reposer sur sa ligne, donc les
      #   lignes ne sont pas des obstacles.
      # Ouvrages ponctuels : pal.dist = LABEL_OFFSET_MAP_UNITS, en unites
      #   carte comme les symboles (regard cercle 1 m, tabouret carre
      #   0.4 m). Le pave n est jamais pose sur le symbole, et le
      #   connecteur a un seuil NUL : il est toujours trace. A 1 m le pave
      #   touchait le symbole et le trait disparaissait, d ou 1.5 m.
      # Rappels des lignes : seuil en MILLIMETRES papier, pas en unites
      #   carte, sinon il se declenche a une distance visuelle differente
      #   selon l echelle.
      # Forcage : displayAll pose couche par couche, et non le flag projet
      #   UseAllLabels qui forcait aussi BAN / PCI / BD TOPO.
      #   _clear_legacy_engine_flag() nettoie les projets <= 1.3.
      # Seuil de dezoom : scaleVisibility + minimumScale, regle dans
      #   EtiquetteTailleDialog et persiste dans le .bet. Le defaut est
      #   DEDUIT de la taille du texte (coupe sous 1.5 mm papier) et non
      #   une constante : mesure sur 1200 regards, un rendu au 1:1000
      #   coutait 3.3 s pour des etiquettes de 0.6 mm illisibles, contre
      #   6 a 16 ms une fois le seuil deduit (1:400 pour du 0.625 m).
      #   Le cout est dans la tentative de placement, pas le resultat : la
      #   plupart des etiquettes tentees sont ecartees en collision.
      #
      # ── Note reconstruction ──
      # apply_etiquettes() part de remembered_size() (QSettings
      #   CanaPlan/label_size_*) et non de LABEL_SIZE_MAP_UNITS :
      #   reconstruire un etiquetage ne doit pas ramener un plan monte au
      #   1:250 (0.625 m) a la taille par defaut (2 m).
      # sync_labels_after_rename() ne reconstruit QUE si la couche n a
      #   jamais ete etiquetee — rebatir ecraserait la taille. Elle
      #   rallume en revanche toujours les etiquettes : on renumerote pour
      #   lire les nouveaux numeros. Reconstruction et rallumage etaient
      #   auparavant lies dans la meme branche, d ou l ecrasement de
      #   taille au moindre renommage.
    }

