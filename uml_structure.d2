      "+labels(liste)": "list[str]"
      "+code_at(liste, index)": "str"
      "+index_of(liste, code)": "int"
      "-_MATERIAU_ALIASES / _MATERIAU_EXACTS": ""
      "-_normalize(text)": "str"
      # Note : source unique des materiaux de conduite, partagee par
      # ConfigDialog, TableauSaisieDialog et l export StaR-Eau, sinon la
      # synthese de cubature groupee par materiau se scinde en deux lignes
