@startuml BET_HUMIDE – Diagramme structurel

skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam class {
  BackgroundColor #FAFAFA
  BorderColor #555
  ArrowColor #333
  FontSize 12
}
skinparam package {
  BackgroundColor #F0F4FF
  BorderColor #88A
}
skinparam note {
  BackgroundColor #FFFFF0
  BorderColor #AAA
}

' ─────────────────────────────────────────
'  Classes externes QGIS (base)
' ─────────────────────────────────────────
package "QGIS API" <<external>> #EEF0EE {
  class QObject       <<PyQt>>
  class QDockWidget   <<PyQt>>
  class QDialog       <<PyQt>>
  class QLineEdit     <<PyQt>>
  abstract class QgsMapTool         <<QGIS>>
  abstract class QgsMapToolEmitPoint <<QGIS>>
  QgsMapToolEmitPoint --|> QgsMapTool
}

' ─────────────────────────────────────────
'  Plugin racine
' ─────────────────────────────────────────
package "BET_HUMIDE" #F0F4FF {

  class ReseauAssainissementPlugin {
    - iface : QgisInterface
    - toolbar : QToolBar
    - menu : QMenu
    - action_dict : dict[str, QAction]
    - tool_group : QActionGroup
    - tools : dict[str, QgsMapTool]
    - side_panel : SidePanel
    .. Constantes ..
    + LAYER_DEFINITIONS : dict
    + COLORS : dict
    .. Cycle de vie ..
    + initGui()
    + unload()
    .. Outils de dessin ..
    + run_conduite_eu(checked)
    + run_conduite_ep(checked)
    + run_branchement_eu(checked)
    + run_branchement_ep(checked)
    + run_insert_regard(checked)
    .. Edition ..
    + run_renseignement(checked)
    + run_delete(checked)
    + run_move(checked)
    + run_copy_attributes(checked)
    .. Analyse ..
    + run_profil_eu(checked)
    + run_profil_ep(checked)
    + run_profil_groupe(checked)
    + run_cubature(checked)
    + run_remblai(checked)
    + run_coupe_transversale(checked)
    + run_coupe_eu(checked)
    + run_coupe_ep(checked)
    + run_coupe_tranchee_composee()
    .. Renumerotation ..
    + run_renommer_eu(checked)
    + run_renommer_ep(checked)
    .. Etiquettes / Annotations ..
    + creer_etiquettes()
    + toggle_affichage_etiquettes(checked)
    + run_taille_etiquettes()
    + run_forcer_etiquettes(checked)
    + run_affichage_etiquettes()
    + run_annotation(checked)
    .. Gestion de projet ..
    + run_fond_projet()
    + run_enregistrer_projet()
    + run_enregistrer_projet_sous()
    + run_charger_projet()
    + run_imprimer()
    + run_export()
    + run_import_dxf()
    + run_import_star_dt()
    .. Fonds de plan ..
    + run_ban_vecteur()
    + run_nom_voie()
    + run_pci_emprise()
    + run_ortho_2022()
    + run_osm_desature()
    .. Configuration ..
    + show_config_dialog()
    .. Privees ..
    - _get_couches(reseau) : dict
    - _get_or_create_group(reseau)
    - _create_layer(role, reseau) : QgsVectorLayer
    - _apply_style(layer, role, reseau)
    - _ensure_fields(layer, role)
    - _activate_tool(key, tool)
    - _deactivate_current()
    - _cleanup_tools()
    - _add_action(...) : QAction
    - _wfs_emprise(typename, layer_name, wfs_url)
    - _style_pci_layer(layer, layer_name)
  }

