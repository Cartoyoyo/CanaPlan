# ═══════════════════════════════════════════════════════════════════════
#  CanaPlan — Diagramme structurel (v1.6)
#  Source de reference, en remplacement de l ancien uml_structure.puml.
#
#  Rendu :   d2 uml_structure.d2 uml_structure.svg
#  Watch  :  d2 --watch uml_structure.d2
#  Requiert D2 >= 0.6.3 (mot-cle « classes » applique aux connexions).
#
#  Conventions, a respecter en editant :
#   - un conteneur par package Python. L imbrication reelle est conservee :
#     bet > gui, bet > tools > dxf_convert. Les connexions utilisent donc
#     le chemin complet (bet.tools.MoveTool).
#   - "── Section ──" : rubrique interne d une classe, rendue comme une
#     ligne de membre sans type (equivalent du separateur PlantUML).
#   - "[static]" suffixe un membre statique.
#   - les commentaires # portent les notes de conception, invisibles au
#     rendu. Pour en afficher une, ajouter une forme texte et la relier.
#   - visibilite en prefixe de cle : + public, - prive, # protege.
# ═══════════════════════════════════════════════════════════════════════

direction: right

classes: {
  inherit: {
    style.stroke: "#333333"
    target-arrowhead: {shape: triangle; style.filled: false}
  }
  compose: {
    style.stroke: "#333333"
    source-arrowhead: {shape: diamond; style.filled: true}
  }
  aggregate: {
    style.stroke: "#333333"
    source-arrowhead: {shape: diamond; style.filled: false}
  }
  assoc: {
    style.stroke: "#333333"
    target-arrowhead: {shape: arrow}
  }
  depend: {
    style.stroke: "#777777"
    style.stroke-dash: 3
    target-arrowhead: {shape: arrow}
  }
  module: {
    style.fill: "#FFF6E5"
    style.stroke: "#C89A3C"
  }
  external: {
    style.fill: "#EEF0EE"
    style.stroke: "#7A8A7A"
    style.italic: true
  }
}

# ─────────────────────────────────────────────────────────────────────────
#  Classes externes (Qt / QGIS) — racines d heritage uniquement
# ─────────────────────────────────────────────────────────────────────────
qgis_api: "QGIS API" {
  style.fill: "#EEF0EE"
  style.stroke: "#8888AA"

  QObject: "QObject «PyQt»" {shape: class; class: external}
  QDockWidget: "QDockWidget «PyQt»" {shape: class; class: external}
  QDialog: "QDialog «PyQt»" {shape: class; class: external}
  QLineEdit: "QLineEdit «PyQt»" {shape: class; class: external}
  QWidget: "QWidget «PyQt»" {shape: class; class: external}
  QgsMapTool: "QgsMapTool «QGIS, abstract»" {shape: class; class: external}
  QgsMapToolEmitPoint: "QgsMapToolEmitPoint «QGIS, abstract»" {shape: class; class: external}
}

# ─────────────────────────────────────────────────────────────────────────
#  Plugin
# ─────────────────────────────────────────────────────────────────────────
bet: "CanaPlan" {
  style.fill: "#F0F4FF"
  style.stroke: "#8888AA"

  ReseauAssainissementPlugin: {
    shape: class

    "-iface": "QgisInterface"
    "-toolbar": "QToolBar"
    "-menu": "QMenu"
    "-action_dict": "dict[str, QAction]"
    "-tool_group": "QActionGroup"
    "-tools": "dict[str, QgsMapTool]"
    "-side_panel": "SidePanel"

    "── Constantes ──": ""
    "+LAYER_DEFINITIONS": "dict"
    "+COLORS": "dict"

    "── Cycle de vie ──": ""
    "+initGui()": ""
    "+unload()": ""

    "── Outils de dessin ──": ""
    "+run_conduite_eu(checked)": ""
    "+run_conduite_ep(checked)": ""
    "+run_branchement_eu(checked)": ""
    "+run_branchement_ep(checked)": ""
    "+run_insert_regard(checked)": ""

    "── Edition ──": ""
    "+run_renseignement(checked)": ""
    "+run_delete(checked)": ""
    "+run_move(checked)": ""
    "+run_copy_attributes(checked)": ""

    "── Analyse ──": ""
    "+run_profil_eu(checked)": ""
    "+run_profil_ep(checked)": ""
    "+run_profil_groupe(checked)": ""
    "+run_cubature(checked)": ""
    "+run_coupe_transversale(checked)": ""
    "+run_coupe_eu(checked)": ""
    "+run_coupe_ep(checked)": ""
    "+run_coupe_tranchee_composee()": ""

    "── Renumerotation ──": ""
    "+run_renommer_eu(checked)": ""
    "+run_renommer_ep(checked)": ""

    "── Etiquettes / Annotations ──": ""
    "+creer_etiquettes()": ""
    "+toggle_affichage_etiquettes(checked)": ""
    "+run_taille_etiquettes()": ""
    "+run_forcer_etiquettes(checked)": ""
    "+run_affichage_etiquettes()": ""
    "+run_annotation(checked)": ""

    "── Gestion de projet ──": ""
    "+run_nouveau_projet_assistant()": ""
    "+run_fond_projet(options)": ""
    "+run_enregistrer_projet()": ""
    "+run_enregistrer_projet_sous()": ""
    "+run_charger_projet()": ""
    "+run_imprimer()": ""
    "+run_export()": ""
    "+run_import_dxf()": ""
    "+run_import_star_dt()": ""

    "── Export StaR-Eau ──": ""
    "+run_export_stareau()": ""
    "-_stareau_dlg": "StarEauExportDialog"
    "-_do_export_stareau()": ""

    "── Aide ──": ""
    "+show_about_dialog()": ""

    "── Fonds de plan ──": ""
    "+run_ban_vecteur()": ""
    "+run_nom_voie()": ""
    "+run_pci_parcelles()": ""
    "+run_pci_bati()": ""
    "+run_ortho_2022()": ""
    "+run_osm_desature()": ""

    "── Configuration ──": ""
    "+show_config_dialog()": ""

    # Note menu : le menu Extensions > CanaPlan est construit en
    # sous-menus (menu_groups) reprenant exactement les categories du
    # SidePanel. En tete : toggleViewAction() de la toolbar (etat
    # synchronise par Qt). En pied : l action "A propos" (hors toolbar).

    "── Privees ──": ""
    "-_get_couches(reseau)": "dict"
    "-_get_or_create_group(reseau)": ""
    "-_create_layer(role, reseau)": "QgsVectorLayer"
    "-_apply_style(layer, role, reseau)": ""
    "-_ensure_fields(layer, role)": ""
    "-_activate_tool(key, tool)": ""
    "-_deactivate_current()": ""
    "-_cleanup_tools()": ""
    "-_add_action(icon, text, cb, checkable, add_to_toolbar)": "QAction"
    "-_wfs_emprise(typename, layer_name, wfs_url)": ""
    "-_style_pci_layer(layer, layer_name)": ""
  }

  # ───────────────────────────────────────────────────────────────────────
  #  Package gui
  # ───────────────────────────────────────────────────────────────────────
  gui: "gui" {
    style.fill: "#E8F0FF"
    style.stroke: "#8888AA"

    SidePanel: {
      shape: class
      "-plugin": "ReseauAssainissementPlugin"
      "-tree": "QTreeWidget"
      "+__init__(plugin, parent)": ""
      "-_build_ui()": ""
      "-_folder(title)": "QTreeWidgetItem"
      "-_item(parent, ...)": "QTreeWidgetItem"
      "-_on_item_clicked(item, column)": ""
    }

    RenseignementDialog: {
      shape: class
      "-role": "str"
      "-feat": "QgsFeature"
      "-layer": "QgsVectorLayer"
      "-reseau": "str"
      "-couches": "dict"
      "-widgets": "dict[str, QWidget]"
      "-_fe_field": "str"
      "+__init__(role, feat, layer, reseau, couches)": ""
      "-_build_ui()": ""
      "-_make_widget(ftype, extra, val)": "QWidget"
      "-_connect_formula()": ""
      "-_on_committed(changed)": ""
      "-_save()": ""
      "-_calculate_pente()": ""
      "-_fe_at(point, tol)": "float"
    }

    NumericEdit: {
      shape: class
      "-_decimals": "int"
      "+committed": "pyqtSignal"
      "+value()": "float"
      "+setValue(v)": ""
      "-_normalize()": ""
      "+focusInEvent(event)": ""
      "+keyPressEvent(event)": ""
      # Note : validator regex permissif, accepte chiffres, point,
      # virgule, +, -, espaces. value() tokenise et somme :
      # "1-0.25" -> 0.75, "2+0.5-0.1" -> 2.4. Pas d eval.
    }

    PrintSettingsWidget: {
      shape: class
      "+titre_edit": "QLineEdit"
      "+format_combo": "QComboBox"
      "+orient_combo": "QComboBox"
      "+scale_combo": "QComboBox"
      "+dpi_combo": "QComboBox"
      "+rb_manuel": "QRadioButton"
      "+rb_auto": "QRadioButton"
      "+cb_ensemble": "QCheckBox"
      "+ligne_combos": "QWidget"
      "-_custom_spin / _dpi_custom_spin": "QSpinBox"
      "-_custom_widget / _dpi_custom_widget": "QWidget"
      "-_dpi_note / _cadrage_note": "QLabel"
      "+__init__(parent, compact, disposition)": ""
      "-_monter_en_ligne()": ""
      "-_on_scale_changed(index)": ""
      "-_on_dpi_changed()": ""
      "-_on_cadrage_changed()": ""
      "-_suggest_dpi()": ""
      "+get_settings()": "dict"
      # Note : bloc partage entre ExportDialog (disposition inline, listes
      # nues a la suite de la case Plan PDF) et PrintDialog (formulaire).
      # Resolution 96/150/200/300 dpi ou personnalisee, suggeree selon le
      # format : A4->300, A2/A3->200, A0/A1->150 ; n ecrase pas une saisie
      # personnalisee active.
      # Cadrage automatique et plan d ensemble coches par defaut.
    }

    PrintDialog: {
      shape: class
      "+reglages": "PrintSettingsWidget"
      "+titre_edit / format_combo / orient_combo / scale_combo": "(relais)"
      "+__init__(parent)": ""
      "+get_settings()": "dict"
      # Note : simple enveloppe autour de PrintSettingsWidget. N est plus
      # ouverte par le plugin — les reglages vivent dans ExportDialog — mais
      # reste utilisee par PrintTool._reopen_settings (Echap pendant la pose,
      # pour changer d echelle sans reprendre les planches). Les widgets sont
      # relayes tels quels car l appelant les manipule directement.
    }

    ProfilDialog: {
      shape: class
      "-data": "dict"
      "-opts": "dict"
      "-color": "str"
      "+__init__(data, opts, parent)": ""
      "-_build_ui()": ""
      "-_draw()": ""
      "-_draw_regard_band(ax, ...)": ""
      "-_draw_piquage_band(ax, ...)": ""
      "-_draw_profile(ax, ...)": ""
      "-_draw_cartouche(ax, ...)": ""
      "-_export(fmt)": ""
      # Note : nom de fichier exporte {nom_dep}_{nom_arr}_PROFIL.{fmt}
    }

    ProfilOptionsDialog: {
      shape: class
      "-cb_cartouche": "QCheckBox"
      "-cb_fleches": "QCheckBox"
      "-cb_noms": "QCheckBox"
      "-cb_distances": "QCheckBox"
      "-format_combo": "QComboBox"
      "+__init__(parent)": ""
      "+get_options()": "dict"
    }

    ExportDialog: {
      shape: class
      "+reglages": "PrintSettingsWidget"
      "-cb_pdf / cb_dxf": "QCheckBox"
      "-cb_eu / cb_ep / cb_grp": "QCheckBox"
      "-fmt_eu / fmt_ep / fmt_grp": "QComboBox"
      "-ref_grp": "QComboBox"
      "-cb_cubature": "QCheckBox"
      "-cub_perimetre": "QComboBox"
      "-cub_conduites / cub_branchements": "QCheckBox"
      "-cub_pdf / cub_xlsx / cub_csv": "QCheckBox"
      "-cb_coupe_eu / cb_coupe_ep": "QCheckBox"
      "-coupe_papier / coupe_fichier": "QComboBox"
      "-_tout_en_un": "bool"
      "-dir_edit": "QLineEdit"
      "+__init__(parent, default_dir)": ""
      "+get_choices()": "dict"
      "+get_print_settings()": "dict"
      "-_bloc_plan / _bloc_profils / _bloc_cubature / _bloc_coupes": ""
      "-_bloc_tout_en_un(layout)": ""
      "-_sync_impression()": ""
      "-_on_tout_en_un()": "bool"
      # Note : fenetre unique — sorties a produire ET reglages du plan.
      # Le plugin n ouvre plus PrintDialog. Les reglages sont grises tant
      # que ni PDF ni DXF n est coche.
      # Bouton « Toutes les pieces (ZIP) », en coin haut droit : ignore les
      # cases et produit plan PDF+DXF, profils EU/EP, cubature remblai
      # (PDF+XLSX) et coupes types EU/EP dans une archive.
    }

    ProfilGroupeDialog: {
      shape: class
      "-data": "dict"
      "-opts": "dict"
      "+__init__(data, options, parent)": ""
      "-_draw(fig)": ""
      "-_export(fmt)": ""
      # Note : nom de fichier exporte
      # {eu_dep}_{eu_arr}_{ep_dep}_{ep_arr}_PROFIL.{fmt}
    }

    EtiquetteTailleDialog: {
      shape: class
      "-chk_min": "QCheckBox"
      "-spin_min": "QSpinBox"
      "+__init__(init_mode, init_value, init_min_scale, parent)": ""
      "-_restore_scale_combo(value_m)": ""
      "+get_result()": "(mode, value, min_scale)"
      # Note : init_mode = "map_units" | "points". Lit QSettings
      # CanaPlan/label_size_mode et label_size_value pour restaurer le
      # dernier reglage a l ouverture.
      # init_min_scale vient des couches (get_label_min_scale) et non de
      # QSettings : c est une propriete du projet ouvert, pas une
      # preference utilisateur. 0 = aucun seuil.
    }

    AnnotationDialog: {
      shape: class
      "-_color": "QColor"
      "-text_edit": "QTextEdit"
      "-font_combo": "QFontComboBox"
      "-size_spin": "QDoubleSpinBox"
      "-color_btn": "QPushButton"
      "-btn_bold / btn_italic / btn_underline": "QToolButton"
      "-_align_group": "QButtonGroup"
      "+__init__(parent, text, font_name, size=2.0, ...)": ""
      "+get_values()": "dict"
      "-_pick_color()": ""
      "-_refresh_color_btn()": ""
      "-_fmt_btn(...) [static]": "QToolButton"
      # Note : taille en metres (RenderMapUnits), suit le zoom, ne grossit
      # plus relativement aux conduites au dezoom.
    }

    CoupeTransversaleDialog: {
      shape: class
      "-crossings": "list[dict]"
      "-config": "dict"
      "-_scale": "int"
      "-_cut_line_pts": "list[QgsPointXY]"
      "-figure": "Figure"
      "-canvas": "FigureCanvas"
      "-fmt_combo": "QComboBox"
      "-lbl_scale": "QLabel"
