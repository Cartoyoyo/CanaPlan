      "-_render_situation_plan(ax_sit)": ""
      "-_refresh()": ""
      "-_export_pdf()": ""
    }

    CubatureDialog: {
      shape: class
      "-results": "list[dict]"
      "-config": "dict"
      "-show_remblai": "bool"
      "-bfs_prefix": "str"
      "-table": "QTableWidget"
      "-cb_remblai": "QCheckBox"
      "-total_label": "QLabel"
      "-_VOL_BREAKDOWN [static]": "list[dict]"
      "+__init__(results, config, parent, bfs_prefix, show_remblai=False)": ""
      "-_active_vol_cols()": "list[dict]"
      "-_synthese_data()": "list[dict]"
      "-_avg(values) [static]": "float"
      "-_build_ui()": ""
      "-_adjust_size_to_content()": ""
      "-_on_toggle_remblai(checked)": ""
      "-_update_info_label()": ""
      "-_populate_table()": ""
      "-_set_row(row, data)": ""
      "-_default_filename(ext)": "str"
      "-_export_csv()": ""
      "-_export_pdf()": ""
      "-_export_pdf_reportlab(path)": ""
      "-_export_xlsx()": ""
      "-_open_folder(path)": ""
    }

    CubatureDialog_note: |md
      **Fenetre unique Cubature / Remblai**

      La case « detail remblai » affiche ou masque les colonnes de volume
      a la volee, avec sous-totaux par colonne, une section « Synthese des
      ouvrages » (PDF + Excel) et un redimensionnement auto au contenu.
    | {
      style.fill: "#FFFFF0"
      style.stroke: "#AAAAAA"
    }

    CubatureOptionsDialog: {
      shape: class
      "-rb_tout": "QRadioButton"
      "-rb_eu": "QRadioButton"
      "-rb_ep": "QRadioButton"
      "-cb_conduites": "QCheckBox"
      "-cb_branchements": "QCheckBox"
      "-cb_bfs": "QCheckBox"
      "-cb_axe": "QCheckBox"
      "+__init__(parent)": ""
      "+options()": "dict"
      "-_build_ui()": ""
      "-_validate_and_accept()": ""
    }

    EtiquetteAffichageDialog: {
      shape: class
      "+__init__(prefs, parent)": ""
      "+get_prefs()": "dict"
    }

    StarDtDialog: {
      shape: class
      "-_files": "list[str]"
      "-file_edit / out_edit": "QLineEdit"
      "-checkboxes": "dict[str, QCheckBox]"
      "-count_labels": "dict[str, QLabel]"
      "+__init__(parent)": ""
      "+file_paths()": "list[str]"
      "+file_path()": "str"
      "+output_path()": "str"
      "+get_selected_types()": "list"
      "── Glisser-deposer ──": ""
      "+dragEnterEvent(event)": ""
      "+dragMoveEvent(event)": ""
      "+dropEvent(event)": ""
      "-_paths_from_mime(mime)": "list[str]"
      "── Privees ──": ""
      "-_browse()": ""
      "-_browse_out()": ""
      "-_set_files(paths)": ""
      "-_scan()": ""
      "-_clear_types_layout()": ""
      # Note : multi-fichiers via QFileDialog.getOpenFileNames + drop de
      # .gml/.xml sur le dialogue (les QLineEdit refusent le drop pour
      # laisser l evenement remonter). Le scan cumule les comptages de
      # tous les fichiers.
    }

    StarEauExportDialog: {
      shape: class
      "-iface": "QgisInterface"
      "-tabs": "QTabWidget"
      "-buttons": "QDialogButtonBox"
      "-_issues": "list[dict]"
      "-_watched": "list[(QgsVectorLayer, list[signal])]"
      "-_check_timer": "QTimer"
      "+__init__(iface, parent)": ""
      "+run_check()": ""
      "+params()": "dict"
      "+output_path()": "str"
      "── Onglets ──": ""
      "-_tab_fichier()": ""
      "-_tab_chantier()": ""
      "-_tab_reseau()": ""
      "-_tab_ouvrages()": ""
      "-_tab_controle()": ""
      "── Controle live ──": ""
      "-_watch_layers()": ""
      "-_unwatch_layers()": ""
      "-_schedule_check(...)": ""
      "-_zoom_to_issue(item)": ""
      "+changeEvent(event)": ""
      "+closeEvent(event)": ""
      "── Persistance ──": ""
      "-_widgets()": "dict"
      "-_save()": ""
      "-_restore()": ""
      "── Privees ──": ""
      "-_combo(liste)": "QComboBox"
      "-_code(combo)": "str"
      "-_browse_dir()": ""
      "-_refresh_name()": ""
      "-_name_params()": "dict"
      "-_on_accept()": ""
      # Note : dialogue NON modal, le controle renvoie vers des objets a
      # corriger dans QGIS. Un modal empecherait la correction et
      # "Relancer le controle" ne detecterait jamais rien.
      # Toutes les combos sont alimentees par stareau_values : produire un
      # code invalide est structurellement impossible.
      # Les couches sont ecoutees (featureAdded, geometryChanged,
      # attributeValueChanged...) et un QTimer de 400 ms regroupe les
      # modifications en rafale en un seul controle.
    }

    AboutDialog: {
      shape: class
      "-plugin_dir": "str"
      "+__init__(plugin_dir, parent)": ""
      "-_read_metadata()": "dict"
      "-_build_ui()": ""
      # Note : lit metadata.txt (configparser) — nom, version, auteur,
      # about, homepage, linkedin. Aucune donnee dupliquee.
    }

    CoupeTrancheeComposeeDialog: {
      shape: class
      "-_tranches": "list[dict]"
      "-_current": "int"
      "-_updating": "bool"
      "-_list": "QListWidget"
      "-_form_widget": "QWidget"
      "-_fig": "Figure"
